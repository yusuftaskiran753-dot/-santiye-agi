# Şantiye Ağı web sitesi: ortam değişkenleri (Vercel → Project → Settings → Environment Variables)

# Sitenin kanonik adresi (sonunda / olmadan). Canonical, sitemap, Open Graph ve JSON-LD bu adresi kullanır.
NEXT_PUBLIC_SITE_URL=https://santiyeagi.com.tr

# Talep formunun WhatsApp numarası: ülke kodlu, yalnızca rakam (ör. 905551234567).
# Boş bırakılırsa form, mesajı "kişi seç" (wa.me/?text=) modunda açar; alıcıyı kullanıcı seçer.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Mağaza bağlantıları. Uygulama yayınlanınca doldurun: "Yakında" rozetleri gerçek mağaza düğmelerine dönüşür
# ve JSON-LD'ye downloadUrl/installUrl eklenir.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=

# Google Search Console doğrulama kodu (meta etiketi içeriği).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# İsteğe bağlı: canlı ihale akışı (JSON). Boşsa "Örnek ihale" kartları gösterilir. Biçim için src/lib/tenders.ts.
TENDERS_FEED_URL=
